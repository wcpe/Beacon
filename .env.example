# Beacon 部署环境变量样例。复制为 .env 并填真实值。
# .env 已被 .gitignore 排除，切勿提交真实密码。

# —— 数据库 ——
# 默认 SQLite（单文件、开箱即用），DSN 指向容器内可写路径。
BEACON_DB_DRIVER=sqlite
BEACON_DB_DSN=/data/beacon.db
# 若要改用 MySQL：先自备数据库实例，再解开下面两行并填连接串
#（仓库的 docker compose 不会创建 MySQL；CI 里的 MySQL 仅用于跑集成测试）
# BEACON_DB_DRIVER=mysql
# BEACON_DB_DSN=beacon:change-me@tcp(127.0.0.1:3306)/beacon?parseTime=true&charset=utf8mb4

# —— Beacon 控制面 ——
# agent 端共享 token，仅防误连（非安全边界，见 SECURITY.md）
BEACON_BOOTSTRAP_TOKEN=change-me-bootstrap-token
# API 与管理台监听端口（二者同端口）
BEACON_HTTP_ADDR=:8848

# —— 管理面鉴权（FR-11，见 docs/adr/0009）——
# 管理台操作者用户名（可缺省，默认 admin）
BEACON_ADMIN_USERNAME=admin
# 管理台操作者口令（敏感项，必填，切勿提交真实值）
BEACON_ADMIN_PASSWORD=change-me-admin-password
# 登录令牌 HMAC 签名密钥（敏感项，必填，建议长随机串）
BEACON_AUTH_SECRET=change-me-auth-secret

# —— 宿主端口映射（docker compose）——
# BEACON_PUBLISH_PORT=8848
# GOPROXY=https://proxy.golang.org,direct

# —— 真机部署 SSH（可选；仅本地填写，切勿提交真实主机/账号）——
# BEACON_DEPLOY_HOST=203.0.113.10
# BEACON_DEPLOY_PORT=22
# BEACON_DEPLOY_USER=your-ssh-user
# BEACON_DEPLOY_SSH_KEY=~/.ssh/beacon_realhost_ed25519
# BEACON_DEPLOY_KNOWN_HOSTS=~/.ssh/beacon_realhost_known_hosts
# BEACON_DEPLOY_REMOTE_DIR=~/beacon-realhost
# BEACON_DEPLOY_PUBLISH_PORT=8848
