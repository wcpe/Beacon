# IDE / 操作系统
/.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# 过程性文档与临时文件（不入库，遵 .claude/rules/git-commit）
.tmp
**/.tmp
.tmp/**



.narrafork/
package-lock.json

# 环境与密钥（不入库）
.env

# Go 控制面
/beacon
/bin/
*.exe
*.out

# 打包产物（make package / release 输出，不入库）
/dist/

/apps/*/.turbo/
/apps/*/dist/*
!/apps/*/dist/.gitkeep
/packages/*/.turbo/
/packages/*/dist/
# Turborepo 本地缓存（由 turbo run 生成，不入库）
/.turbo/
# 忽略 dist 内构建产物，但保留占位 .gitkeep（供后端 go:embed all:apps/web/dist 在未构建前端时仍可编译）
# 注意：须忽略目录内容（/apps/*/dist/*）而非目录本身，否则父目录被排除会使下面的 .gitkeep 例外失效
# MSW worker 由 apps/web/vite.config.ts 从已锁定依赖复制生成，不直接入库。
/apps/web/public/mockServiceWorker.js

# Kotlin / Gradle agent
/apps/agent/.gradle/
/apps/agent/**/build/
/apps/agent/**/.gradle/


/config.yaml
/beacon.db

# 首启运行时生成的控制面配置（embed 源为 config.example.yml），不入库。
# 注意模式用 `**/` 而非仅根目录 `/`：控制面在「当前工作目录」释放该文件，
# 而从 apps/server 或任意子目录启动时会在那里生成一份**含随机口令与签名密钥**的副本；
# 只挡根目录会让这些副本成为可被 `git add` 的未跟踪文件（实测发生过）。
**/config.yml
**/config.yaml
**/beacon.db
/.playwright-cli/
node_modules
**/node_modules
node_modules/**
/.beacon/
