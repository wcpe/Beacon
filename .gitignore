# IDE / 操作系统
/.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# 过程性文档与临时文件（不入库，遵 .claude/rules/git-commit）
/.tmp/
.narrafork/
package-lock.json

# 环境与密钥（不入库）
.env

# Go 控制面
/beacon
/bin/
*.exe
*.out

# 打包产物（make package / release 输出，不入库）
/dist/

# 前端 React / Vite
/web/node_modules/
# 忽略 dist 内构建产物，但保留占位 .gitkeep（供后端 go:embed all:web/dist 在未构建前端时仍可编译）
# 注意：须忽略目录内容（/web/dist/*）而非目录本身，否则父目录被排除会使下面的 .gitkeep 例外失效
/web/dist/*
!/web/dist/.gitkeep
# vendored Monaco 编辑器资产（scripts/vendor-monaco.mjs 由 node_modules 重生成，dev/build 前自动跑，不入库二进制）
/web/public/monaco/
# 前端测试覆盖率报告（vitest --coverage 产物，不入库）
/web/coverage/
# Playwright E2E 产物（报告 / 结果 / 真后端运行目录），不入库
/web/test-results/
/web/playwright-report/
/web/.e2e-real-run/

# Kotlin / Gradle agent
/agent/.gradle/
/agent/**/build/
/agent/**/.gradle/


/config.yaml
/beacon.db

# 首启运行时生成的控制面配置（embed 源为 config.example.yml），不入库
/config.yml
/.playwright-cli/
